{
  "name": "termloom",
  "version": "0.1.0",
  "description": "A terminal-native remote workspace for SSH, tmux, SFTP, and rich previews.",
  "license": "MIT",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "termloom": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "build": "bun build src/index.ts --compile --minify --outfile dist/termloom"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "1.3.14",
    "@types/mime-types": "3.0.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@xterm/headless": "6.0.0",
    "bun-pty": "0.4.10",
    "hast-util-to-text": "4.0.2",
    "kitty-motion": "1.4.0",
    "mathjax": "4.1.3",
    "mime-types": "3.0.2",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "smol-toml": "1.7.1",
    "term-img": "7.1.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.4.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}
